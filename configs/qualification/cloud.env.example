# Independent cloud qualification profile. Supply database/API credentials separately.
# Worker heartbeat cadence is lease_seconds / 3: one second for this profile.
FORGE_LEASE_SECONDS=3
FORGE_TELEMETRY_MAX_QUEUE_SIZE=64
FORGE_TELEMETRY_MAX_EXPORT_BATCH_SIZE=1
FORGE_TELEMETRY_SCHEDULE_DELAY_MILLIS=10
OTEL_PYTHON_SDK_INTERNAL_METRICS_ENABLED=true

# Copy to .env locally. Do not commit keys or a populated .env.
FORGE_DATABASE_URL=postgresql+psycopg://forge:forge_local@127.0.0.1:55471/forge
FORGE_API_TOKEN=replace-with-a-random-local-token
FORGE_API_URL=http://127.0.0.1:8765
FORGE_OWNER_ID=local
FORGE_DATA_DIR=.forge
FORGE_CONFIG_DIR=configs
FORGE_ALLOWED_REPO_ROOTS=["/absolute/path/to/allowed/repositories"]
# Match the socket printed by bash scripts/rootless-daemon.sh.
# FORGE_DOCKER_HOST=unix:///tmp/forge-rootless-1000/docker.sock
FORGE_ALLOW_ROOTFUL_DEVELOPMENT=false
FORGE_ENABLE_EVALUATIONS=false
# FORGE_EVAL_PRIVATE_DIR=.forge/private-evals
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Copy to .env locally. Do not commit keys or a populated .env.
FORGE_DATABASE_URL=postgresql+psycopg://forge:forge_local@127.0.0.1:55471/forge
FORGE_API_TOKEN=replace-with-a-random-local-token
FORGE_API_URL=http://127.0.0.1:8765
FORGE_OWNER_ID=local
FORGE_DATA_DIR=.forge
FORGE_CONFIG_DIR=configs
FORGE_ALLOWED_REPO_ROOTS=["/absolute/path/to/allowed/repositories"]
# Match the socket printed by bash scripts/rootless-daemon.sh.
# FORGE_DOCKER_HOST=unix:///run/user/1000/forge-rootless/docker.sock
FORGE_ALLOW_ROOTFUL_DEVELOPMENT=false
FORGE_ENABLE_EVALUATIONS=false
# FORGE_EVAL_PRIVATE_DIR=.forge/private-evals
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# Optional OTLP HTTP trace receiver. JSONL remains enabled independently.
# FORGE_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Each sink has its own queue; batch size must not exceed queue size.
FORGE_TELEMETRY_MAX_QUEUE_SIZE=256
FORGE_TELEMETRY_MAX_EXPORT_BATCH_SIZE=32
FORGE_TELEMETRY_SCHEDULE_DELAY_MILLIS=200
# Passed to the OTLP HTTP exporter, not the SDK batch processor.
FORGE_TELEMETRY_EXPORT_TIMEOUT_SECONDS=2
FORGE_TELEMETRY_MAX_ATTRIBUTES=12
FORGE_TELEMETRY_MAX_ATTRIBUTE_LENGTH=128
# Optional SDK queue/drop measurements must be exported by the launching shell:
# export OTEL_PYTHON_SDK_INTERNAL_METRICS_ENABLED=true
# Adding the SDK flag to .env alone does not enable it: Settings does not copy
# extra .env fields into the process environment. Without it, queue/drop metrics
# are null (unknown), while Forge export success/failure counters remain available.
